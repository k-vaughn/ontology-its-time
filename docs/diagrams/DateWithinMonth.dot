	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		xsd_integer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">xsd:integer</TD></TR></TABLE>> URL="https://w3id.org/citydata/imported/xsd/latest/integer" margin=0]
	}
	DateWithinMonth -> DayWeekMonth [arrowhead=onormal style=solid]
	DateWithinMonth -> Invis [style=invis]
	Invis -> xsd_integer [style=invis]
	xsd_integer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">xsd:integer</TD></TR></TABLE>> URL="https://w3id.org/citydata/imported/xsd/latest/integer" margin=0]
	DateWithinMonth -> xsd_integer [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">applicableDayOfMonth</TD></TR><TR><TD ALIGN="CENTER">1..31</TD></TR></TABLE>> arrowhead=normal style=solid]
}
